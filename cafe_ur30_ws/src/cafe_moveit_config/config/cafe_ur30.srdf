<?xml version="1.0"?>
<robot name="cafe_ur30">
  <!-- Planning group: base_link -> gripper_tcp (the tool centre point between the fingers) -->
  <group name="ur_manipulator">
    <chain base_link="base_link" tip_link="gripper_tcp"/>
  </group>

  <group_state name="observe" group="ur_manipulator">
    <joint name="shoulder_pan_joint" value="1.5708"/>
    <joint name="shoulder_lift_joint" value="-1.5708"/>
    <joint name="elbow_joint" value="1.5708"/>
    <joint name="wrist_1_joint" value="-1.5708"/>
    <joint name="wrist_2_joint" value="-1.5708"/>
    <joint name="wrist_3_joint" value="0"/>
  </group_state>

  <!-- Adjacent / never-colliding pairs (UR arm) -->
  <disable_collisions link1="base_link_inertia" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="base_link_inertia" link2="upper_arm_link" reason="Never"/>
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="forearm_link" reason="Never"/>
  <disable_collisions link1="shoulder_link" link2="wrist_1_link" reason="Never"/>
  <disable_collisions link1="upper_arm_link" link2="forearm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent"/>
  <!-- Gripper -->
  <disable_collisions link1="wrist_3_link" link2="gripper_base" reason="Adjacent"/>
  <disable_collisions link1="wrist_2_link" link2="gripper_base" reason="Never"/>
  <disable_collisions link1="wrist_1_link" link2="gripper_base" reason="Never"/>
  <disable_collisions link1="wrist_3_link" link2="finger_left" reason="Never"/>
  <disable_collisions link1="wrist_3_link" link2="finger_right" reason="Never"/>
  <disable_collisions link1="gripper_base" link2="finger_left" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="finger_right" reason="Adjacent"/>
  <disable_collisions link1="finger_left" link2="finger_right" reason="Never"/>
</robot>
