<?xml version="1.0" ?>
<!-- Café kitchen workspace. World z=0 is the floor, the table top is at z=0.75.
     The UR30 is spawned at the world origin and stands on the table (see cafe_ur30.urdf.xacro).
     Overhead RGB-D camera: (0.75, 0, 1.75) looking straight down; its optical frame
     `camera_optical_frame` is published as a static TF by sim.launch.py (same pose). -->
<sdf version="1.8">
  <world name="cafe">
    <physics name="physics" type="dart">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.81</gravity>
    <scene><ambient>0.55 0.55 0.55 1</ambient><background>0.75 0.8 0.85 1</background></scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.3 0.2 -1.0</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.35 0.35 0.38 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="table">
      <static>true</static>
      <pose>0.45 0 0.375 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.9 2.0 0.75</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.9 2.0 0.75</size></box></geometry>
          <material>
            <ambient>0.72 0.72 0.70 1</ambient><diffuse>0.72 0.72 0.70 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="overhead_camera">
      <static>true</static>
      <pose>0.75 0 1.75 0 1.5707963 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.05 0.10 0.05</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
        <sensor name="rgbd_camera" type="rgbd_camera">
          <topic>camera</topic>
          <update_rate>5</update_rate>
          <always_on>1</always_on>
          <visualize>false</visualize>
          <ignition_frame_id>camera_optical_frame</ignition_frame_id>
          <camera>
            <horizontal_fov>1.2</horizontal_fov>
            <image><width>320</width><height>240</height></image>
            <clip><near>0.3</near><far>5.0</far></clip>
            <depth_camera><clip><near>0.3</near><far>5.0</far></clip></depth_camera>
          </camera>
        </sensor>
      </link>
    </model>

    <model name="serve_red">
      <static>true</static>
      <pose>0.05 0.72 0.751 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.26 0.16 0.002</size></box></geometry>
          <material>
            <ambient>1.0 0.65 0.65 1</ambient><diffuse>1.0 0.65 0.65 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="serve_blue">
      <static>true</static>
      <pose>0.33 0.72 0.751 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.26 0.16 0.002</size></box></geometry>
          <material>
            <ambient>0.65 0.75 1.0 1</ambient><diffuse>0.65 0.75 1.0 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="serve_green">
      <static>true</static>
      <pose>0.61 0.72 0.751 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.26 0.16 0.002</size></box></geometry>
          <material>
            <ambient>0.65 1.0 0.7 1</ambient><diffuse>0.65 1.0 0.7 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="tray_red">
      <pose>0.7 -0.15 0.772 0 0 0.4</pose>
      <link name="link">
        <inertial>
          <mass>0.3</mass>
          <inertia><ixx>0.00029</ixx><iyy>0.00085</iyy><izz>0.00106</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.18 0.1 0.04</size></box></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.18 0.1 0.04</size></box></geometry>
          <material>
            <ambient>0.85 0.08 0.08 1</ambient><diffuse>0.85 0.08 0.08 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="tray_blue">
      <pose>0.82 0.12 0.772 0 0 -0.6</pose>
      <link name="link">
        <inertial>
          <mass>0.3</mass>
          <inertia><ixx>0.00029</ixx><iyy>0.00085</iyy><izz>0.00106</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.18 0.1 0.04</size></box></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.18 0.1 0.04</size></box></geometry>
          <material>
            <ambient>0.1 0.2 0.9 1</ambient><diffuse>0.1 0.2 0.9 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="tray_green">
      <pose>0.62 0.2 0.772 0 0 1.2</pose>
      <link name="link">
        <inertial>
          <mass>0.3</mass>
          <inertia><ixx>0.00029</ixx><iyy>0.00085</iyy><izz>0.00106</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.18 0.1 0.04</size></box></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.18 0.1 0.04</size></box></geometry>
          <material>
            <ambient>0.08 0.65 0.1 1</ambient><diffuse>0.08 0.65 0.1 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
